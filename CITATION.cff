    family-names: Soni
repository-code: "https://github.com/sonii-shivansh/cycle-integral-sensor-certificates"
url: "https://github.com/sonii-shivansh/cycle-integral-sensor-certificates"
keywords:
  - sensor consistency
  - fault diagnosis
  - first-order sensors
  - control theory
  - scientific software
  - reproducible research
